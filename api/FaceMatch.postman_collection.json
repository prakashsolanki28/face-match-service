{
  "info": {
    "_postman_id": "cd23b2df-6151-5bdf-b03c-9e063dcf9798",
    "name": "FaceMatch API",
    "description": "Every FaceMatch 3.0.0 endpoint, ready to send.\n\n1. Import `FaceMatch.postman_environment.json` too and select the **FaceMatch** environment. Set `baseUrl` to your server and `apiKey` to your API key (the `API_KEY` setting).\n2. Send **System → Health check**, then **Auth → Check API key**.\n3. For photos, open **Body → form-data** and choose a file in each `image` / `images` row.\n\nEnrolling a person saves the new id in `personId` for the requests that need it.\n\nThe API key: https://github.com/prakashsolanki28/face-match-service/blob/main/docs/api-keys.md\n\nGenerated from the OpenAPI spec by `face-match export-api`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "System",
      "description": "Service info, health check and metrics.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Liveness/readiness probe: also checks that the database answers.\n\n**Auth:** none (public)."
          },
          "response": []
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Prometheus metrics. Needs the API key when auth is on.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        },
        {
          "name": "Service info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Service identification for humans and load balancers.\n\n**Auth:** none (public)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Check that your API key works.",
      "item": [
        {
          "name": "Check API key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "check"
              ]
            },
            "description": "Answers only when the request carries the right API key (otherwise 401).\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Faces",
      "description": "Detect and identify faces. Nothing is recorded.",
      "item": [
        {
          "name": "Detect faces",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/detect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "detect"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) A photo: JPEG, PNG, WebP or BMP."
                }
              ]
            },
            "description": "Find faces in an image (no identity lookup).\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        },
        {
          "name": "Recognize faces",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/recognize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "recognize"
              ],
              "query": [
                {
                  "key": "liveness",
                  "value": "",
                  "description": "Check recognised faces for a printed photo or a screen held up to the camera; one that fails is returned without its match (unknown_reason liveness_failed). Defaults to the server's LIVENESS setting. Use false for uploaded photos, which aren't re-captured.",
                  "disabled": true
                },
                {
                  "key": "closest",
                  "value": "false",
                  "description": "For testing and tuning: also return the nearest enrolled person for unknown faces.",
                  "disabled": true
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) A photo: JPEG, PNG, WebP or BMP."
                }
              ]
            },
            "description": "Find faces and identify enrolled people. Does not record anything.\n\nEach recognised face has `match.person_id` (and your `external_id`): use these to act on the\nresult, for example to mark people present in your own system.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Persons",
      "description": "Enroll, update and remove people and their photos.",
      "item": [
        {
          "name": "Enroll a person",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/persons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "persons"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "description": "(Required) 1-10 clear, front-facing photos. Add one row per photo."
                },
                {
                  "key": "name",
                  "value": "Asha Verma",
                  "description": "Full name. Optional.",
                  "type": "text"
                },
                {
                  "key": "external_id",
                  "value": "STU0001",
                  "description": "Your system's ID for this person, e.g. admission number. Optional.",
                  "type": "text"
                },
                {
                  "key": "metadata",
                  "value": "{\"class\": \"7-A\", \"section\": \"B\", \"roll_no\": 12}",
                  "description": "Optional. Your own fields for this person, as a JSON object of text, numbers, true/false or null (no nested objects or lists). Up to 50 keys of at most 64 characters; text values up to 1000 characters. Returned with the person and with every match, including to kiosks, so don't store secrets here. Send it as JSON text in this form field.",
                  "type": "text"
                },
                {
                  "key": "allow_duplicate",
                  "value": "false",
                  "description": "Enroll even if the face resembles someone already enrolled (twins).",
                  "disabled": true,
                  "type": "text"
                }
              ]
            },
            "description": "Enroll a person. Only photos are required: the response's `person.id` is returned as\n`person_id` in every match, so store it in your system. 3-5 photos (slightly different\nangles/lighting) give the best accuracy.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the new id in the collection variable `personId` for the next requests.",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"personId\", pm.response.json().person.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List people",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/persons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "persons"
              ],
              "query": [
                {
                  "key": "external_id",
                  "value": "EMP-001",
                  "description": "Look up one person by your system's ID.",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "",
                  "description": "Page size (default: everyone).",
                  "disabled": true
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Skip this many results (for paging).",
                  "disabled": true
                }
              ]
            },
            "description": "People sorted by name. `X-Total-Count` holds the total for paging.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        },
        {
          "name": "Get a person",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/persons/:person_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "persons",
                ":person_id"
              ],
              "variable": [
                {
                  "key": "person_id",
                  "value": "{{personId}}",
                  "description": "The person's id, returned when they were enrolled."
                }
              ]
            },
            "description": "One person, by the id returned at enrollment.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        },
        {
          "name": "Update a person",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/persons/:person_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "persons",
                ":person_id"
              ],
              "variable": [
                {
                  "key": "person_id",
                  "value": "{{personId}}",
                  "description": "The person's id, returned when they were enrolled."
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Verma\",\n  \"external_id\": \"STU0001\",\n  \"metadata\": {\n    \"class\": \"8-A\",\n    \"roll_no\": 12,\n    \"section\": \"B\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Change a person's name, external_id or metadata. Only the fields you send change;\n`metadata` replaces all of the person's own fields. Photos are changed with /faces.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        },
        {
          "name": "Add photos to a person",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/persons/:person_id/faces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "persons",
                ":person_id",
                "faces"
              ],
              "variable": [
                {
                  "key": "person_id",
                  "value": "{{personId}}",
                  "description": "The person's id, returned when they were enrolled."
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "description": "(Required) 1-10 photos: JPEG, PNG, WebP or BMP. Add one row per photo."
                }
              ]
            },
            "description": "Add more photos to an existing person to improve recognition.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        },
        {
          "name": "Replace a person's photos",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/persons/:person_id/faces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "persons",
                ":person_id",
                "faces"
              ],
              "variable": [
                {
                  "key": "person_id",
                  "value": "{{personId}}",
                  "description": "The person's id, returned when they were enrolled."
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "description": "(Required) 1-10 photos: JPEG, PNG, WebP or BMP. Add one row per photo."
                },
                {
                  "key": "allow_duplicate",
                  "value": "false",
                  "description": "Accept the photos even if they resemble someone else enrolled (twins).",
                  "disabled": true,
                  "type": "text"
                }
              ]
            },
            "description": "Replace all photos of a person (e.g. new school-year photos).\n\nAll-or-nothing: if none of the new photos is usable, the current photos are kept.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        },
        {
          "name": "Delete a person",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/persons/:person_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "persons",
                ":person_id"
              ],
              "variable": [
                {
                  "key": "person_id",
                  "value": "{{personId}}",
                  "description": "The person's id, returned when they were enrolled."
                }
              ]
            },
            "description": "Delete a person and all their face data.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "description": "The audit log.",
      "item": [
        {
          "name": "Audit log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "audit"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Page size.",
                  "disabled": true
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Skip this many results (for paging).",
                  "disabled": true
                },
                {
                  "key": "action",
                  "value": "",
                  "description": "Filter, e.g. person.* or person.update",
                  "disabled": true
                },
                {
                  "key": "actor",
                  "value": "",
                  "description": "Exact actor, e.g. api_key.",
                  "disabled": true
                }
              ]
            },
            "description": "Who changed what: enrollments, updates, photo changes and deletions. Newest first.\n\n**Auth:** the API key, in the `X-API-Key` header (or `Authorization: Bearer`)."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "description": "Your FaceMatch server."
    },
    {
      "key": "personId",
      "value": "",
      "description": "Set by earlier requests, or by hand."
    }
  ]
}
