# FaceMatch configuration. Copy to .env and adjust; every value is optional.
# Full reference: docs/configuration.md

# --- server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# text or json (one JSON object per line, for log shippers)
LOG_FORMAT=text

# --- security ---
# Clients send this in the X-API-Key header. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Without API_KEY the service only starts on localhost. Set true to run an open API on a network on purpose.
ALLOW_NO_AUTH=false
# Web UI sign-in lifetime, and whether the session cookie is marked Secure (auto = when HTTPS).
SESSION_HOURS=12
SESSION_COOKIE_SECURE=auto
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=*
# Reverse proxies trusted for X-Forwarded-For (client IP used by rate limiting)
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- abuse protection ---
RATE_LIMIT_PER_MINUTE=600
AUTH_FAILURES_PER_MINUTE=20
MAX_CONCURRENT_IMAGES=8

# --- storage ---
# PostgreSQL lets several FaceMatch servers share data (pip install "face-match-service[postgres]").
# DATABASE_URL=postgresql://facematch:secret@localhost:5432/facematch
# GALLERY_SYNC_SECONDS=2
DATA_DIR=./data
MODELS_DIR=./models
AUTO_DOWNLOAD_MODELS=true

# --- recognition tuning ---
# Cosine similarity needed to accept a match. Higher = fewer false matches, more "unknown".
MATCH_THRESHOLD=0.40
# The best match must beat the next-best *different* person by this much, otherwise the
# face is reported as unknown. Prevents wrong names when hundreds of people are enrolled.
MATCH_MARGIN=0.05
# Enrollment: a photo at least this similar to a DIFFERENT enrolled person is rejected as a duplicate.
DUPLICATE_THRESHOLD=0.50
DETECTION_THRESHOLD=0.60
MIN_FACE_SIZE=40
MIN_ENROLL_FACE_SIZE=40
MAX_IMAGE_SIDE=1600
MAX_UPLOAD_MB=8

# --- attendance ---
# Repeat sightings of the same person inside this window are not logged again.
ATTENDANCE_COOLDOWN_SECONDS=300
# IANA timezone used for "which day" an event belongs to. Empty = server local time.
TIMEZONE=

# --- integration ---
# Each new attendance event is POSTed here as JSON.
WEBHOOK_URL=
# When set, requests carry X-Signature-256: sha256=<HMAC of the raw body>.
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=20
WEBHOOK_RETRY_BASE_SECONDS=5

# --- data protection ---
# Automatic backups into DATA_DIR/backups (0 disables) and how many to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Delete attendance events older than this many days (0 keeps them forever).
ATTENDANCE_RETENTION_DAYS=0
# Delete audit-log entries older than this many days (0 keeps them forever).
AUDIT_RETENTION_DAYS=0

# --- liveness (anti-spoofing) for /attendance ---
LIVENESS=on
LIVENESS_THRESHOLD=0.5
